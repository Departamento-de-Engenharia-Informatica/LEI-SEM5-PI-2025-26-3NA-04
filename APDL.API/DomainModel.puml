        Entity PortAuthorityOfficer <<Aggregate Root>>{
         -
        
        }

        Class PortAuthorityOfficerId <<Value Object>> {
            - id: EntityId
        }

  
 PortAuthorityOfficer "1" *-r- "1" PortAuthorityOfficerId
 PortAuthorityOfficer "0..1" --> "0..1" UserId
}

