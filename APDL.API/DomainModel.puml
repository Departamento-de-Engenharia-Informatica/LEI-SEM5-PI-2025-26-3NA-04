@startuml Domain Model

package "User"{

        Entity User <<Aggregate Root>>{
        - username: String
        - password: String
        - role: String
        - email: String
        
        }

        Class UserId <<Value Object>> {
            - id: EntityId
        }

   User "1" *-- "1" UserId
}



